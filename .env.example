# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your real settings are never committed.

# Login (required — if NOVA_PASSWORD is empty, a random one is printed at startup)
NOVA_USERNAME=admin
NOVA_PASSWORD=change-me-to-a-long-random-password

# Session signing key (generate one with: python -c "import secrets; print(secrets.token_hex(32))")
NOVA_SECRET_KEY=

# Ollama endpoint
OLLAMA_API_URL=http://localhost:11434

# Server — keep 127.0.0.1 unless you deliberately want other machines to connect
NOVA_HOST=127.0.0.1
NOVA_PORT=5000

# Never enable on a network-reachable host: the debugger allows code execution
NOVA_DEBUG=0
